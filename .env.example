# ============================================================
# Cabin – Secure Notes & Private Sharing Platform
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME=Cabin
APP_URL=https://yourcabin.com
APP_ENV=production
APP_DEBUG=false
# Generate with: php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
APP_KEY=base64:CHANGE_ME_GENERATE_32_RANDOM_BYTES

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cabin_db
DB_USERNAME=cabin_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_CHARSET=utf8mb4

# Admin Panel
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_LIFETIME=7200

# Cron
CRON_SECRET=CHANGE_ME_RANDOM_CRON_SECRET

# File Uploads
MAX_UPLOAD_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp
MAX_IMAGES_PER_NOTE=5
UPLOAD_PATH=storage/uploads

# Note Limits
MAX_NOTE_LENGTH=50000
DEFAULT_EXPIRY=86400

# Rate Limiting
RATE_LIMIT_CREATE=10
RATE_LIMIT_VIEW=60
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_PASSWORD_WINDOW=900

# Session
SESSION_NAME=cabin_session
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict
